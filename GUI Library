    if IconID and IconID ~= "" then
        local FinalIcon = IconID
        if tonumber(IconID) then
            FinalIcon = "rbxassetid://" .. IconID
        end
        
        Icon.Image = FinalIcon
        Icon.Visible = true
        
        TextLabel.Size = UDim2.new(1, -55, 0, 0)
        TextLabel.Position = UDim2.new(0, 42, 0, 0)
    else
        Icon.Visible = false
        TextLabel.Size = UDim2.new(1, -30, 0, 0)
        TextLabel.Position = UDim2.new(0, 15, 0, 0)
    end

    local LabelPadding = Instance.new("UIPadding")
    LabelPadding.PaddingTop = UDim.new(0, 10)
    LabelPadding.PaddingBottom = UDim.new(0, 10)
    LabelPadding.Parent = LabelFrame

    table.insert(AllElements, {Frame = LabelFrame, Name = LabelText, Tab = TabPage})

    local LabelMethods = {}
    function LabelMethods:Set(NewText)
        TextLabel.Text = NewText
    end
    return LabelMethods
end

