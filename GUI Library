    UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local InternalLayout = Instance.new("UIListLayout", Frame)
    InternalLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local InternalPadding = Instance.new("UIPadding", Frame)
    InternalPadding.PaddingBottom = UDim.new(0, 10)

    local Header = Instance.new("Frame")
