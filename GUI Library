local dragging, dragStart, startPos, hasMoved
MobileToggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        hasMoved = false
        dragStart = input.Position
        startPos = MobileToggle.Position
        
        TweenService:Create(MobileToggle, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 36, 0, 36)
        }):Play()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 5 then
            hasMoved = true
        end
        MobileToggle.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        
        TweenService:Create(MobileToggle, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 42, 0, 42)
        }):Play()
        
        if not hasMoved then
            local BurstStroke = MobileToggleStroke
            local OriginalColor = BurstStroke.Color
            
            local FlashTween = TweenService:Create(BurstStroke, TweenInfo.new(0.15, Enum.EasingStyle.QuadOut), {Color = Color3.new(1, 1, 1)})
            local FadeTween = TweenService:Create(BurstStroke, TweenInfo.new(0.25, Enum.EasingStyle.QuadIn), {Color = OriginalColor})
            
            FlashTween:Play()
            FlashTween.Completed:Connect(function() FadeTween:Play() end)
            
            task.wait(0.1)
            Main.Visible = true
            MobileToggle.Visible = false
        end
    end
end)

