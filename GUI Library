    Icon.ImageColor3 = Settings.Accent
    Icon.Visible = (imageID ~= 0)
    Icon.Parent = Header

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -50, 0, 0) 
    TitleLabel.Position = imageID ~= 0 and UDim2.new(0, 40, 0, 0) or UDim2.new(0, 10, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = tostring(title)
    TitleLabel.TextColor3 = Settings.Text
    TitleLabel.TextSize = 16
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.TextWrapped = true
    TitleLabel.AutomaticSize = Enum.AutomaticSize.Y
    TitleLabel.Parent = Header

    local TimerContainer = Instance.new("Frame")
    TimerContainer.Size = UDim2.new(1, 0, 0, 2)
    TimerContainer.BackgroundTransparency = 1
    TimerContainer.LayoutOrder = 2
    TimerContainer.Parent = Frame

    local TimerBackground = Instance.new("Frame")
    TimerBackground.Size = UDim2.new(1, -20, 0, 2)
    TimerBackground.Position = UDim2.new(0, 10, 0, 0)
    TimerBackground.BackgroundColor3 = Settings.Scheme
    TimerBackground.BorderSizePixel = 0
    TimerBackground.Parent = TimerContainer

    local TimerBar = Instance.new("Frame")
    TimerBar.Size = UDim2.new(1, 0, 1, 0)
    TimerBar.BackgroundColor3 = Settings.Accent
    TimerBar.BorderSizePixel = 0
    TimerBar.Parent = TimerBackground
    Instance.new("UICorner", TimerBar)

    local ContentLabel = Instance.new("TextLabel")
    ContentLabel.Size = UDim2.new(1, 0, 0, 0)
    ContentLabel.BackgroundTransparency = 1
    ContentLabel.Text = tostring(content)
    ContentLabel.TextColor3 = Settings.Text
    ContentLabel.TextSize = 14
    ContentLabel.Font = Enum.Font.GothamSemibold
    ContentLabel.TextWrapped = true
    ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
    ContentLabel.TextYAlignment = Enum.TextYAlignment.Top
    ContentLabel.AutomaticSize = Enum.AutomaticSize.Y
    ContentLabel.LayoutOrder = 3
    ContentLabel.Parent = Frame

    local TextPadding = Instance.new("UIPadding", ContentLabel)
    TextPadding.PaddingLeft = UDim.new(0, 10)
    TextPadding.PaddingRight = UDim.new(0, 10)
    TextPadding.PaddingTop = UDim.new(0, 8)

    Frame:TweenPosition(UDim2.new(0.5, 0, 0, 0), "Out", "Back", 0.8, true)

    task.delay(0.8, function()
        TweenService:Create(TimerBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)}):Play()
    end)

    task.delay(duration + 0.8, function()
        if Frame then
            Frame:TweenPosition(UDim2.new(1.5, 0, 0, 0), "In", "Back", 0.8, true, function()
                Container:Destroy()
            end)
        end
    end)
end

