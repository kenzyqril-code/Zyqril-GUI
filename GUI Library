    TextPadding.PaddingLeft = UDim.new(0, 10)
    TextPadding.PaddingRight = UDim.new(0, 10)
    TextPadding.PaddingTop = UDim.new(0, 8)

    Frame:TweenPosition(UDim2.new(0.5, 0, 0, 0), "Out", "Back", 0.8, true)

    task.delay(0.8, function()
        TweenService:Create(TimerBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)}):Play()
    end)

    task.delay(duration + 0.8, function()
        if Frame then
            Frame:TweenPosition(UDim2.new(1.5, 0, 0, 0), "In", "Back", 0.8, true, function()
                Container:Destroy()
            end)
        end
    end)
end

