local MobileToggle = Instance.new("ImageButton")
MobileToggle.Name = "MobileToggle"
MobileToggle.Size = UDim2.new(0, 50, 0, 50)
MobileToggle.Position = UDim2.new(0.1, 0, 0.1, 0)
MobileToggle.BackgroundTransparency = 1
MobileToggle.Image = "rbxassetid://100895094193345"
MobileToggle.Visible = false
MobileToggle.Active = true
MobileToggle.Parent = GUI

local dragging, dragStart, startPos
MobileToggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MobileToggle.Position
        
        local originalPos = MobileToggle.Position
        for i = 1, 8 do
            local xOffset = math.random(-6, 6)
            local yOffset = math.random(-6, 6)
            MobileToggle.Position = originalPos + UDim2.new(0, xOffset, 0, yOffset)
            task.wait(0.02)
        end
        MobileToggle.Position = originalPos
        
        task.wait(0.5)
        
        if not dragging then 
            Main.Visible = true
            MobileToggle.Visible = false
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MobileToggle.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

