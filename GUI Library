    TimerContainer.BackgroundTransparency = 1
    TimerContainer.LayoutOrder = 2
    TimerContainer.Parent = Frame

    local TimerBackground = Instance.new("Frame")
    TimerBackground.Size = UDim2.new(1, -20, 0, 2)
    TimerBackground.Position = UDim2.new(0, 10, 0, 0)
    TimerBackground.BackgroundColor3 = Settings.TopBar
    TimerBackground.BorderSizePixel = 0
    TimerBackground.Parent = TimerContainer

    local TimerBar = Instance.new("Frame")
    TimerBar.Size = UDim2.new(1, 0, 1, 0)
    TimerBar.BackgroundColor3 = Settings.Accent
    TimerBar.BorderSizePixel = 0
    TimerBar.Parent = TimerBackground
    Instance.new("UICorner", TimerBar)

    local ContentLabel = Instance.new("TextLabel")
    ContentLabel.Size = UDim2.new(1, 0, 0, 0)
    ContentLabel.BackgroundTransparency = 1
    ContentLabel.Text = tostring(content)
    ContentLabel.TextColor3 = Settings.Text
    ContentLabel.TextSize = 14
    ContentLabel.Font = Enum.Font.GothamSemibold
    ContentLabel.TextWrapped = true
    ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
    ContentLabel.TextYAlignment = Enum.TextYAlignment.Top
