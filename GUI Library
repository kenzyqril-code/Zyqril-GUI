function Zyqril:CreateWindow(Config)
    local Name = Config.Name or "Zyqril Hub"
    local LTitle = Config.LoadingTitle or "Zyqril Hub"
    local LSub = Config.LoadingSubtitle or "by Zyqril"
    local ToggleKey = Enum.KeyCode.RightControl

    function Zyqril:Unload()
        local Target = gethui and gethui():FindFirstChild("ZyqrilUI") or CoreGui:FindFirstChild("ZyqrilUI") or playerGui:FindFirstChild("ZyqrilUI")
        if Target then
            Target:Destroy()
        end
    end

    if Config.Theme and Themes[Config.Theme] then
        Settings = Themes[Config.Theme]
    end
    
    local GUI = Instance.new("ScreenGui")
    GUI.Name = "ZyqrilUI"
    GUI.ResetOnSpawn = false
    
    local success, err = pcall(function()
        GUI.Parent = gethui and gethui() or CoreGui
    end)
    if not success then GUI.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui") end

