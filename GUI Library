            SliderBar.Size = UDim2.new(0, 140, 0, 26)
            SliderBar.AnchorPoint = Vector2.new(1, 0.5)
            SliderBar.Position = UDim2.new(1, -10, 0.5, 0)
            SliderBar.BackgroundColor3 = Settings.Scheme
            SliderBar.BackgroundTransparency = 1
            SliderBar.ClipsDescendants = true 
            SliderBar.Active = true
            SliderBar.Parent = SliderFrame
            Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(0, 13)

            local SliderStroke = Instance.new("UIStroke")
            SliderStroke.Thickness = 1.2
            SliderStroke.Color = Settings.Accent
            SliderStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            SliderStroke.Transparency = 0.5
            SliderStroke.Parent = SliderBar

            local Fill = Instance.new("Frame")
            local Min = Config.Range[1]
            local Max = Config.Range[2]
            local Increment = Config.Increment or 1
            local Suffix = Config.Suffix or ""
            
            local initPercent = math.clamp((Config.CurrentValue - Min) / (Max - Min), 0, 1)
            Fill.Size = UDim2.new(initPercent, 0, 1, 0)
            Fill.BackgroundColor3 = Settings.Accent 
            Fill.ZIndex = 2
            Fill.Parent = SliderBar
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 13)

            local ValueLabel = Instance.new("TextLabel")
            ValueLabel.Size = UDim2.new(1, 0, 1, 0)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = tostring(Config.CurrentValue) .. " " .. Suffix
            ValueLabel.TextColor3 = Settings.Text 
            ValueLabel.Font = Enum.Font.GothamBold
            ValueLabel.TextSize = 11
            ValueLabel.ZIndex = 3 
            ValueLabel.Parent = SliderBar

            local function Round(num, step)
                local mult = 1 / step
                local rounded = math.floor(num * mult + 0.5) / mult
                local str = tostring(step)
                local decimalPlaces = 0
                if str:find("%.") then
                    decimalPlaces = #str - str:find("%.")
                end
                return tonumber(string.format("%." .. decimalPlaces .. "f", rounded))
            end

            local isDragging = false
            local function Update()
                local MousePos = UserInputService:GetMouseLocation()
                local RelativeX = MousePos.X - SliderBar.AbsolutePosition.X
                local Percent = math.clamp(RelativeX / SliderBar.AbsoluteSize.X, 0, 1)
                
                local RawValue = Min + (Max - Min) * Percent
                local Value = Round(RawValue, Increment)
                Value = math.clamp(Value, Min, Max)
                
                local DisplayPercent = math.clamp((Value - Min) / (Max - Min), 0, 1)
                
                ValueLabel.Text = tostring(Value) .. " " .. Suffix
                TweenService:Create(Fill, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {Size = UDim2.new(DisplayPercent, 0, 1, 0)}):Play()
                Config.Callback(Value)
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = true
                    TweenService:Create(SliderStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
                    Update()
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = false
                    TweenService:Create(SliderStroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
                end
            end)

            RunService.RenderStepped:Connect(function() 
                if isDragging then Update() end 
            end)

            local SliderMethods = {}
            function SliderMethods:Set(NewValue)
                local Val = Round(math.clamp(NewValue, Min, Max), Increment)
                local DisplayPercent = math.clamp((Val - Min) / (Max - Min), 0, 1)
                ValueLabel.Text = tostring(Val) .. " " .. Suffix
                TweenService:Create(Fill, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {Size = UDim2.new(DisplayPercent, 0, 1, 0)}):Play()
                Config.Callback(Val)
            end
            return SliderMethods
        end

