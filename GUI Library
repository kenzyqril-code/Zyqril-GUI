function Zyqril:Notify(Config)
    local title = Config.Title or "Notification"
    local content = Config.Content or ""
    local duration = Config.Duration or 5
    local imageID = Config.Image or 0

    local Container = Instance.new("Frame")
    Container.Name = "NotificationContainer"
    Container.BackgroundTransparency = 1
    Container.Size = UDim2.new(1, 0, 0, 0)
    Container.AutomaticSize = Enum.AutomaticSize.Y
    Container.LayoutOrder = os.clock() * 100 
    Container.Parent = Holder

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 0)
    Frame.Position = UDim2.new(1.5, 0, 0, 0) 
    Frame.AnchorPoint = Vector2.new(0.5, 0)
    Frame.BackgroundColor3 = Settings.Background
    Frame.BackgroundTransparency = 0
    Frame.BorderSizePixel = 0
    Frame.AutomaticSize = Enum.AutomaticSize.Y
    Frame.Parent = Container

    local UICorner = Instance.new("UICorner", Frame)
    UICorner.CornerRadius = UDim.new(0, 13)

    local UIStroke = Instance.new("UIStroke", Frame)
    UIStroke.Color = Settings.Text
    UIStroke.Transparency = 0.8
    UIStroke.Thickness = 2.5
    UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local InternalLayout = Instance.new("UIListLayout", Frame)
    InternalLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local InternalPadding = Instance.new("UIPadding", Frame)
    InternalPadding.PaddingBottom = UDim.new(0, 10)

    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 0) 
    Header.BackgroundTransparency = 1
    Header.LayoutOrder = 1
    Header.AutomaticSize = Enum.AutomaticSize.Y
    Header.Parent = Frame
    
    local HeaderPadding = Instance.new("UIPadding", Header)
    HeaderPadding.PaddingTop = UDim.new(0, 10)
    HeaderPadding.PaddingBottom = UDim.new(0, 5)

    local Icon = Instance.new("ImageLabel")
    Icon.Size = UDim2.new(0, 25, 0, 25)
    Icon.Position = UDim2.new(0, 10, 0, 0)
    Icon.BackgroundTransparency = 1
